# ============================================
# IIB (Identity in a Box) Configuration
# ============================================
# Run `make generate-secrets` to fill in the GENERATE_ME values,
# or let `make up` do it automatically on first run.
# ============================================

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3004

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8432
VICTORIAMETRICS_RETENTION=90d

# ==================== Authentik ====================
AUTHENTIK_PORT_HTTP=9080
AUTHENTIK_PORT_HTTPS=9443

# Bootstrap admin account — set before first start
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME

# Auto-generated secrets — do not set manually
AUTHENTIK_SECRET_KEY=GENERATE_ME
AUTHENTIK_BOOTSTRAP_TOKEN=GENERATE_ME
POSTGRES_PASSWORD=GENERATE_ME

# ==================== Monitor ====================
SYNC_INTERVAL_MINUTES=15
SYNC_ON_STARTUP=true
# Window for login event counts (hours)
LOOKBACK_HOURS=24
