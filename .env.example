# ============================================
# IIB (Identity in a Box) Configuration
# ============================================
# Run `make generate-secrets` to fill in the GENERATE_ME values,
# or let `make up` do it automatically on first run.
# ============================================

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_PORT=3004

# ==================== VictoriaMetrics ====================
VICTORIAMETRICS_PORT=8432
VICTORIAMETRICS_RETENTION=90d

# ==================== Authentik ====================
AUTHENTIK_PORT_HTTP=9080
AUTHENTIK_PORT_HTTPS=9443
# Authentik image tag. Upstream no longer publishes `latest`; pin a release and bump it deliberately.
AUTHENTIK_TAG=2026.8.3

# Bootstrap admin account (username akadmin). `make generate-secrets` replaces CHANGE_ME with a random password;
# compose refuses to start while a required secret is unset.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME

# Auto-generated secrets — do not set manually
AUTHENTIK_SECRET_KEY=GENERATE_ME
AUTHENTIK_BOOTSTRAP_TOKEN=GENERATE_ME
POSTGRES_PASSWORD=GENERATE_ME

# ==================== Monitor ====================
SYNC_INTERVAL_MINUTES=15
SYNC_ON_STARTUP=true
# Window for login event counts (hours)
LOOKBACK_HOURS=24

# Network exposure (127.0.0.1 is safe for local demos; set 0.0.0.0 for LAN exposure)
BIND_ADDR=127.0.0.1

# ==================== Image tags ====================
# Pinned on purpose: `latest` moves under you (one tag used here has since disappeared upstream).
# Bump deliberately, then re-run the stack's smoke test.
GRAFANA_TAG=13.2.3
VICTORIAMETRICS_TAG=v1.153.0
